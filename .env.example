# Clave de la API de Anthropic. Vive solo en el servidor: no lleva el prefijo
# NEXT_PUBLIC_, así que Next nunca la incluye en el bundle del navegador.
# Solo la lee el route handler de src/app/api/ideas/.
ANTHROPIC_API_KEY=sk-ant-...

# Modelo que usa el route handler de ideas. Cambiarlo no requiere tocar código.
ANTHROPIC_MODEL=claude-opus-5
