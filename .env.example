# Clave de la API de Anthropic. Vive solo en el servidor: no lleva el prefijo
# NEXT_PUBLIC_, así que Next nunca la incluye en el bundle del navegador.
# La leen los tres route handlers: src/app/api/ideas/, /teacher/ y /versiones/.
# Sin ella el resto de la aplicación funciona igual; solo callan esas tres.
ANTHROPIC_API_KEY=sk-ant-...

# Modelo que usan los route handlers. Cambiarlo no requiere tocar código,
# pero sí cambia los cupos de todos los planes: salen de su precio. Tiene que
# estar en la tabla de src/core/billing/cost.ts, que dice también qué acepta para
# pensar; uno que no esté se cobra como el peor caso (docs/adr/0103).
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- El techo de gasto de la IA ----------------------------------------------
#
# Lo más que se deja gastar en el modelo ENTRE TODOS, en dólares. Al llegar, la
# IA se cierra para todo el mundo con un 503 que lo dice, hasta mañana o el día
# uno. El de lo gratis es aparte y más bajo: un ataque con cuentas gratis —el
# registro no confirma el correo— cierra lo gratis y no lo que se paga. Sin
# ponerlas valen las de serie, que son las de abajo; con clientes, sube el
# mensual a lo que pueden gastar sus cuentas (docs/DESPLIEGUE.md). Y pon además
# un límite de gasto en la consola de Anthropic: es el único que para una clave
# robada. docs/adr/0114-el-gasto-de-la-ia-tiene-techo-y-la-cuenta-se-cierra-en-orden.md
# IA_TOPE_DIARIO_USD=10
# IA_TOPE_MENSUAL_USD=150
# IA_TOPE_GRATIS_DIARIO_USD=2
# IA_TOPE_GRATIS_MENSUAL_USD=30

# --- El modelo de casa ------------------------------------------------------
#
# Un Ollama al que preguntar sin clave y sin pagar tokens, para probar. Lo levanta
# `pnpm docker:ia`, que además pone estas dos por dentro: aquí solo hacen falta si
# arrancas Ollama por tu cuenta y quieres usarlo desde `pnpm dev`.
#
# La clave de arriba GANA a esto. Con las dos puestas contesta Anthropic, para que
# una variable de probar que se queda puesta no degrade lo que se sirve.
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:8b

# --- Delante de la aplicación ----------------------------------------------
#
# Cuántos proxies de confianza hay delante: un balanceador, una CDN o un nginx.
# Los topes de frecuencia —entrar, registrarse, el profesor— cuentan por
# dirección, y la dirección sale de X-Forwarded-For contando estos saltos desde
# la derecha. Sin la variable no se cree esa cabecera, que la puede escribir
# cualquiera, y todo el mundo comparte los topes. La tabla de cuántos poner según
# dónde se publica está en docs/DESPLIEGUE.md.
#
# Con el Docker de casa, sin proxy delante, pon TRUSTED_PROXY_HOPS=0: dice «sin
# proxy, lo sé» y calla el aviso de arranque. Vacío o ausente no es lo mismo.
# TRUSTED_PROXY_HOPS=1

# --- Cuentas y planes -------------------------------------------------------
#
# Las dos de abajo van juntas: hacen falta las dos para que haya cuentas. Con
# una sola, o sin ninguna, la aplicación funciona ENTERA en modo anónimo —plan
# gratis, avance guardado en el navegador— y las pantallas de cuenta dicen que
# esta copia no tiene cuentas, en vez de fallar con un error que no explica nada.
#
# El porqué de cada decisión está en docs/CUENTAS-Y-PLANES.md.

# Postgres. Cualquiera sirve: Neon, Supabase usado solo como base de datos, o uno
# local. Después de ponerla, aplica las migraciones con `pnpm db:migrate`.
# Hacia un servidor que no sea este equipo ni la red de compose, la conexión va
# cifrada y comprobando el certificado (verify-full), también con el
# `sslmode=require` que traen pegado los proveedores. Para otra cosa, escríbela:
# `?sslmode=disable` hacia una IP privada sin TLS (src/server/db/client.ts).
DATABASE_URL=postgres://usuario:contrasena@servidor/base

# Con qué se firma la cookie de sesión. Una cadena larga y aleatoria:
#   openssl rand -base64 32
# Si cambia, todo el mundo se queda fuera y tiene que volver a entrar. No es
# grave: el avance sigue en su cuenta y en su navegador.
AUTH_SECRET=

# --- Para abrir al público ---------------------------------------------------
#
# Quién publica esta copia. Salen en /aviso-legal y /privacidad (LSSI-CE art. 10),
# y mientras falte alguna las dos páginas dicen cuál, y que sin ellas no se abre.
# No llevan NEXT_PUBLIC_ aunque sean públicas: se leen en el servidor al pintar.
# docs/adr/0111-la-edad-se-declara-y-el-titular-se-configura.md
# TITULAR_NOMBRE=
# TITULAR_NIF=
# TITULAR_DOMICILIO=
# TITULAR_CORREO=
# Quién aloja el servidor y dónde, en una frase: «Un proveedor, Alemania».
# TITULAR_ALOJAMIENTO=

# --- Analítica ---------------------------------------------------------------
#
# Se cuenta sola en la misma base de datos, sin cookies ni terceros
# (docs/adr/0110-contar-sin-seguir.md). Esta clave solo hace falta para LEERLA:
#   curl -H "Authorization: Bearer $METRICAS_CLAVE" https://tu-dominio/api/metricas
# Sin ella, esa ruta no existe.
# METRICAS_CLAVE=

# --- La dirección pública ----------------------------------------------------
#
# De ella salen el enlace del correo de la contraseña y a dónde vuelve quien paga.
# Sin ella se supone http://localhost:3000, que en producción manda a la gente a
# su propio equipo. Con https: además la política de seguridad pide subir a https
# lo que se cuele en http (src/proxy.ts); servida por http no se pide, para que la
# copia de casa se pueda abrir desde el móvil.
# APP_URL=https://tu-dominio

# --- Cobrar ------------------------------------------------------------------
#
# Las seis van juntas: con una que falte no se cobra, y en producción tampoco se
# regala ningún plan (CobroCerrado). Los precios son distintos en la cuenta de
# pruebas de Stripe y en la de verdad. docs/DESPLIEGUE.md, «Cobrar de verdad».
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_BASICO=price_...
# STRIPE_PRICE_MEDIO=price_...
# STRIPE_PRICE_BASICO_ANUAL=price_...
# STRIPE_PRICE_MEDIO_ANUAL=price_...

# --- Correo ------------------------------------------------------------------
#
# El proveedor (Resend) y el remitente, para recuperar la contraseña. Sin las dos,
# /olvidada dice que esta copia no manda correo. MAIL_FROM tiene que ser de un
# dominio verificado en el proveedor.
# MAIL_API_KEY=re_...
# MAIL_FROM=Caos ordenado <hola@tu-dominio>

# --- El techo del gasto en IA ------------------------------------------------
#
# En dólares, sumando lo que cuesta cada pregunta a la API. Al llegar, la IA
# contesta que por hoy (o por este mes) no queda, y lo demás sigue igual. Sin
# ponerlas valen las de serie —10 al día y 150 al mes para todos; 2 y 30 para el
# plan gratis—, y un valor que no se entienda también deja la de serie: un error
# al escribir no puede quitar el techo. Cero cierra. docs/adr/0114.
# IA_TOPE_DIARIO_USD=10
# IA_TOPE_MENSUAL_USD=150
# IA_TOPE_GRATIS_DIARIO_USD=2
# IA_TOPE_GRATIS_MENSUAL_USD=30

# --- Docker: compose.yml -----------------------------------------------------
#
# Estas solo las lee compose. `pnpm docker:up` y `pnpm docker:db` escriben un .env
# con las contraseñas al azar si no hay ninguno, y completan uno de antes sin
# tocar lo que tenga (docs/adr/0117).
#
# Obligatorias: compose no arranca sin ellas. No hay contraseña por defecto.
# El superusuario, que solo usan las migraciones:
# POSTGRES_USER=caos
# POSTGRES_PASSWORD=
# POSTGRES_DB=caos
# El rol con el que entra la aplicación: lee y escribe filas, nada más. Lo crea
# el contenedor de las migraciones (scripts/rol-de-la-aplicacion.mjs).
# POSTGRES_APP_USER=caos_app
# POSTGRES_APP_PASSWORD=
#
# Dónde escucha cada puerto publicado. Por defecto 127.0.0.1: solo este equipo.
# Docker se salta ufw, así que en un servidor 0.0.0.0 es internet entera aunque el
# cortafuegos diga otra cosa. Abrir la aplicación a la red de casa —para probarla
# desde el móvil— es APP_ESCUCHA_EN=0.0.0.0; Postgres y Ollama no tienen motivo.
# APP_ESCUCHA_EN=127.0.0.1
# POSTGRES_ESCUCHA_EN=127.0.0.1
# OLLAMA_ESCUCHA_EN=127.0.0.1
# Y en qué puerto del equipo, si el de siempre está ocupado.
# APP_PORT=3000
# POSTGRES_PORT=5432
# OLLAMA_PORT=11434
