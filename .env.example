# Clave de la API de Anthropic. Vive solo en el servidor: no lleva el prefijo
# NEXT_PUBLIC_, así que Next nunca la incluye en el bundle del navegador.
# La leen los tres route handlers: src/app/api/ideas/, /teacher/ y /versiones/.
# Sin ella el resto de la aplicación funciona igual; solo callan esas tres.
ANTHROPIC_API_KEY=sk-ant-...

# Modelo que usan los tres route handlers. Cambiarlo no requiere tocar código,
# pero sí cambia los cupos de todos los planes: salen de su precio.
ANTHROPIC_MODEL=claude-opus-5

# --- El modelo de casa ------------------------------------------------------
#
# Un Ollama al que preguntar sin clave y sin pagar tokens, para probar. Lo levanta
# `pnpm docker:ia`, que además pone estas dos por dentro: aquí solo hacen falta si
# arrancas Ollama por tu cuenta y quieres usarlo desde `pnpm dev`.
#
# La clave de arriba GANA a esto. Con las dos puestas contesta Anthropic, para que
# una variable de probar que se queda puesta no degrade lo que se sirve.
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:8b

# --- Cuentas y planes -------------------------------------------------------
#
# Las dos de abajo van juntas: hacen falta las dos para que haya cuentas. Con
# una sola, o sin ninguna, la aplicación funciona ENTERA en modo anónimo —plan
# gratis, avance guardado en el navegador— y las pantallas de cuenta dicen que
# esta copia no tiene cuentas, en vez de fallar con un error que no explica nada.
#
# El porqué de cada decisión está en docs/CUENTAS-Y-PLANES.md.

# Postgres. Cualquiera sirve: Neon, Supabase usado solo como base de datos, o uno
# local. Después de ponerla, aplica las migraciones con `pnpm db:migrate`.
DATABASE_URL=postgres://usuario:contrasena@servidor/base

# Con qué se firma la cookie de sesión. Una cadena larga y aleatoria:
#   openssl rand -base64 32
# Si cambia, todo el mundo se queda fuera y tiene que volver a entrar. No es
# grave: el avance sigue en su cuenta y en su navegador.
AUTH_SECRET=
