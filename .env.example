# Clave de la API de Anthropic. Vive solo en el servidor: no lleva el prefijo
# NEXT_PUBLIC_, así que Next nunca la incluye en el bundle del navegador.
# La leen los dos route handlers: src/app/api/ideas/ y src/app/api/teacher/.
# Sin ella el resto de la aplicación funciona igual; solo callan esas dos.
ANTHROPIC_API_KEY=sk-ant-...

# Modelo que usan los dos route handlers. Cambiarlo no requiere tocar código.
ANTHROPIC_MODEL=claude-opus-5
